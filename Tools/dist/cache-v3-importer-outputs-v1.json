{
    "format": "cache-v3-importer-outputs-v1",
    "importers": [
        {
            "audit_rule": "audit.texture-payload-v1",
            "domain": "texture",
            "importer": "texture-v2",
            "max_decoded_size": 268435456,
            "output_schema": "wot-texture-v3",
            "runtime_consumer": "UWoTPayloadSubsystem"
        },
        {
            "audit_rule": "audit.sound-payload-v1",
            "domain": "sound",
            "importer": "sound-v1",
            "max_decoded_size": 268435456,
            "output_schema": "wot-sound-v3",
            "runtime_consumer": "UWoTPayloadSubsystem"
        },
        {
            "audit_rule": "audit.mesh-payload-v1",
            "domain": "mesh",
            "importer": "mesh-v1",
            "max_decoded_size": 536870912,
            "output_schema": "wot-mesh-v3",
            "runtime_consumer": "UWoTPayloadSubsystem"
        },
        {
            "audit_rule": "audit.animation-payload-v1",
            "domain": "animation",
            "importer": "animation-v1",
            "max_decoded_size": 536870912,
            "output_schema": "wot-animation-v3",
            "runtime_consumer": "UWoTVertexAnimComponent"
