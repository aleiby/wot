 namespace {
 
+void require_reasonable_entry_counts(const setup::header & header) {
+	// WoT hardening: setup::info normally trusts these counts and resizes each
+	// vector immediately. The library adapter treats every installer as hostile.
+	static const size_t MaxEntries = 65536;
+	const size_t counts[] = {
+		header.language_count, header.message_count, header.permission_count,
+		header.type_count, header.component_count, header.task_count,
+		header.directory_count, header.file_count, header.data_entry_count,
+		header.icon_count, header.ini_entry_count, header.registry_entry_count,
+		header.delete_entry_count, header.uninstall_delete_entry_count,
+		header.run_entry_count, header.uninstall_run_entry_count
+	};
+	size_t total = 0;
+	for(size_t i = 0; i < sizeof(counts) / sizeof(counts[0]); i++) {
+		if(counts[i] > MaxEntries || total > MaxEntries - counts[i]) {
+			throw std::length_error("setup entry count exceeds WoT adapter limit");
+		}
+		total += counts[i];
+	}
+}
