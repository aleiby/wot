+			if(data_index >= package->info.data_entries.size()) {
+				set_error("GOG file part references an absent data entry");
+				return WOT_INNOEXTRACT_FORMAT_ERROR;
+			}
+			const setup::data_entry & data = package->info.data_entries[data_index];
+			if(data.chunk.encryption != stream::Plaintext) {
+				set_error("encrypted Inno entries are unsupported by the WoT adapter");
+				return WOT_INNOEXTRACT_FORMAT_ERROR;
+			}
+			if(data.uncompressed_size > MaxDecodedBytes
+			   || data.file.offset > MaxFileOffset
+			   || data.file.size > MaxDecodedBytes
+			   || data.file.size > MaxFileOffset - data.file.offset
+			   || (!recovered_gog
+			       && data.file.size != data.uncompressed_size)) {
+				set_error("entry size or offset exceeds the WoT adapter limit");
+				return WOT_INNOEXTRACT_LIMIT_ERROR;
+			}
+			boost::uint64_t available = input_size - package->offsets.data_offset;
+			if(available < 4 || data.chunk.offset > available - 4
+			   || data.chunk.size > available - 4 - data.chunk.offset) {
+				set_error("compressed chunk lies outside the held installer");
+				return WOT_INNOEXTRACT_FORMAT_ERROR;
+			}
+			if(total > MaxDecodedBytes - data.uncompressed_size
+			   || entry.public_entry.uncompressed_size
+			      > MaxDecodedBytes - data.uncompressed_size) {
+				set_error("total decoded size exceeds the WoT adapter limit");
+				return WOT_INNOEXTRACT_LIMIT_ERROR;
+			}
+			total += data.uncompressed_size;
+			entry.public_entry.uncompressed_size += data.uncompressed_size;
+		}
+		const setup::data_entry & first_data =
+			package->info.data_entries[entry.data_indices.front()];
+		entry.checksum = hex_checksum(entry.whole_checksum);
+		entry.public_entry.checksum_type =
+			checksum_type(entry.whole_checksum.type);
+		entry.public_entry.compression =
+			compression_type(first_data.chunk.compression);
+		package->entries.push_back(entry);
+	}
+	if(package->entries.empty()) {
+		set_error("installer contains no embedded file entries");
+		return WOT_INNOEXTRACT_FORMAT_ERROR;
+	}
+	for(size_t i = 0; i < package->entries.size(); i++) {
+		package->entries[i].bind_pointers();
+	}
+	std::ostringstream description;
+	description << "innoextract-1.9;setup=" << package->info.version
+	            << ";entries=" << package->entries.size() << ";io=callback";
+	package->description = description.str();
+	*output_package = package.release();
+	last_error.clear();
+	return WOT_INNOEXTRACT_OK;
+}
+
+int32_t extract_impl(const wot_innoextract_package * package, boost::uint64_t index,
+                     wot_innoextract_write_fn write, void * write_context) {
+	if(package == NULL || write == NULL || index >= package->entries.size()) {
+		set_error("invalid package, entry index, or write callback");
+		return WOT_INNOEXTRACT_INVALID_ARGUMENT;
+	}
+	const adapter_entry & entry = package->entries[size_t(index)];
+	std::unique_ptr<crypto::hasher> whole_hasher;
+	if(entry.whole_checksum.type != crypto::None) {
+		whole_hasher.reset(new crypto::hasher(entry.whole_checksum.type));
+	}
+	boost::uint64_t written = 0;
+	for(size_t part = 0; part < entry.data_indices.size(); part++) {
+		const setup::data_entry & data =
+			package->info.data_entries[entry.data_indices[part]];
+		prepare_cursor(package, data);
+		crypto::checksum actual;
+		stream::file_reader::pointer file =
+			stream::file_reader::get(*package->cursor.chunk, data.file, &actual);
+		boost::uint64_t part_written = 0;
+		while(!file->eof()) {
+			char buffer[64 * 1024];
+			std::streamsize count = file->read(buffer, sizeof(buffer)).gcount();
+			if(count < 0) {
+				package->cursor.invalidate();
+				set_error("negative decoded read size");
+				return WOT_INNOEXTRACT_FORMAT_ERROR;
+			}
+			if(count == 0) {
+				continue;
+			}
+			if(boost::uint64_t(count) > data.uncompressed_size -
+			   std::min(part_written, data.uncompressed_size)) {
+				package->cursor.invalidate();
+				set_error("decoded entry exceeds its declared size");
+				return WOT_INNOEXTRACT_LIMIT_ERROR;
+			}
+			if(whole_hasher.get() != NULL) {
+				whole_hasher->update(buffer, size_t(count));
+			}
+			if(write(write_context, buffer, boost::uint64_t(count)) != 0) {
+				package->cursor.invalidate();
+				set_error("caller write callback rejected decoded bytes");
+				return WOT_INNOEXTRACT_WRITE_ERROR;
+			}
+			part_written += boost::uint64_t(count);
+			written += boost::uint64_t(count);
+		}
+		if(package->cursor.input->callback_failed()) {
+			package->cursor.invalidate();
+			set_error("read callback failed during extraction");
+			return WOT_INNOEXTRACT_IO_ERROR;
+		}
+		if(part_written != data.uncompressed_size) {
+			package->cursor.invalidate();
+			set_error("decoded entry ended before its declared size");
+			return WOT_INNOEXTRACT_FORMAT_ERROR;
+		}
+		if(actual != data.file.checksum) {
+			package->cursor.invalidate();
+			set_error("decoded entry checksum mismatch");
+			return WOT_INNOEXTRACT_FORMAT_ERROR;
+		}
+		package->cursor.position = data.file.offset + data.file.size;
+	}
+	if(written != entry.public_entry.uncompressed_size) {
+		package->cursor.invalidate();
+		set_error("decoded multi-part entry ended before its declared size");
+		return WOT_INNOEXTRACT_FORMAT_ERROR;
+	}
+	if(whole_hasher.get() != NULL
+	   && whole_hasher->finalize() != entry.whole_checksum) {
+		package->cursor.invalidate();
+		set_error("decoded whole-entry checksum mismatch");
+		return WOT_INNOEXTRACT_FORMAT_ERROR;
+	}
+	last_error.clear();
+	return WOT_INNOEXTRACT_OK;
+}
+
+} // anonymous namespace
+
+extern "C" int32_t wot_innoextract_open(
+    wot_innoextract_read_at_fn read_at, void * read_context,
+    uint64_t input_size, wot_innoextract_package ** output_package) {
+	std::lock_guard<std::mutex> lock(library_mutex);
+	try {
+		return open_impl(read_at, read_context, input_size, output_package);
+	} catch(const std::bad_alloc &) {
+		set_error("allocation failed while opening installer");
+		return WOT_INNOEXTRACT_LIMIT_ERROR;
+	} catch(const std::ios_base::failure & error) {
+		set_error(error);
+		return WOT_INNOEXTRACT_FORMAT_ERROR;
+	} catch(const std::exception & error) {
+		set_error(error);
+		return WOT_INNOEXTRACT_FORMAT_ERROR;
+	} catch(...) {
+		set_error("unknown exception while opening installer");
+		return WOT_INNOEXTRACT_INTERNAL_ERROR;
+	}
+}
+
+extern "C" uint64_t wot_innoextract_entry_count(
+    const wot_innoextract_package * package) {
+	std::lock_guard<std::mutex> lock(library_mutex);
+	try {
+		if(package == NULL) {
+			set_error("package is null");
+			return 0;
+		}
+		return package->entries.size();
+	} catch(...) {
+		set_error("unknown exception while counting entries");
+		return 0;
+	}
+}
+
+extern "C" int32_t wot_innoextract_entry_at(
+    const wot_innoextract_package * package, uint64_t index,
+    wot_innoextract_entry * output_entry) {
+	std::lock_guard<std::mutex> lock(library_mutex);
+	try {
+		if(package == NULL || output_entry == NULL || index >= package->entries.size()) {
+			set_error("invalid package, entry index, or output pointer");
+			return WOT_INNOEXTRACT_INVALID_ARGUMENT;
+		}
+		*output_entry = package->entries[size_t(index)].public_entry;
+		last_error.clear();
+		return WOT_INNOEXTRACT_OK;
+	} catch(const std::exception & error) {
+		set_error(error);
+		return WOT_INNOEXTRACT_INTERNAL_ERROR;
+	} catch(...) {
+		set_error("unknown exception while reading entry metadata");
+		return WOT_INNOEXTRACT_INTERNAL_ERROR;
+	}
+}
+
+extern "C" int32_t wot_innoextract_extract_entry(
+    const wot_innoextract_package * package, uint64_t index,
+    wot_innoextract_write_fn write, void * write_context) {
+	std::lock_guard<std::mutex> lock(library_mutex);
+	try {
+		return extract_impl(package, index, write, write_context);
+	} catch(const std::bad_alloc &) {
+		if(package != NULL) package->cursor.invalidate();
+		set_error("allocation failed during extraction");
+		return WOT_INNOEXTRACT_LIMIT_ERROR;
+	} catch(const std::ios_base::failure & error) {
+		if(package != NULL) package->cursor.invalidate();
+		set_error(error);
+		return WOT_INNOEXTRACT_FORMAT_ERROR;
+	} catch(const std::exception & error) {
+		if(package != NULL) package->cursor.invalidate();
+		set_error(error);
+		return WOT_INNOEXTRACT_FORMAT_ERROR;
+	} catch(...) {
+		if(package != NULL) package->cursor.invalidate();
+		set_error("unknown exception during extraction");
+		return WOT_INNOEXTRACT_INTERNAL_ERROR;
+	}
+}
+
+extern "C" const char * wot_innoextract_description(
+    const wot_innoextract_package * package) {
+	std::lock_guard<std::mutex> lock(library_mutex);
+	try {
+		if(package == NULL) {
+			set_error("package is null");
+			return "";
+		}
+		return package->description.c_str();
+	} catch(...) {
+		set_error("unknown exception while reading package description");
+		return "";
+	}
+}
+
+extern "C" void wot_innoextract_close(wot_innoextract_package * package) {
+	std::lock_guard<std::mutex> lock(library_mutex);
+	try {
+		delete package;
+	} catch(...) {
+		set_error("unknown exception while closing package");
+	}
+}
+
+extern "C" const char * wot_innoextract_last_error(void) {
+	std::lock_guard<std::mutex> lock(library_mutex);
+	try {
+		return last_error.c_str();
+	} catch(...) {
+		return "unknown innoextract adapter error";
+	}
+}
