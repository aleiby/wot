+
+namespace {
+
+const boost::uint64_t MaxDecodedBytes = boost::uint64_t(8) * 1024 * 1024 * 1024;
+const boost::uint64_t MaxFileOffset = boost::uint64_t(8) * 1024 * 1024 * 1024;
+thread_local std::string last_error;
+std::mutex library_mutex;
+
+void set_error(const char * message) {
+	try {
+		last_error = message ? message : "unknown innoextract adapter error";
+	} catch(...) {
+		// The accessor must remain callable even under allocation failure.
+	}
+}
+
+void set_error(const std::exception & error) {
+	set_error(error.what());
+}
+
+wot_innoextract_checksum_type checksum_type(crypto::checksum_type type) {
+	switch(type) {
+		case crypto::None: return WOT_INNOEXTRACT_CHECKSUM_NONE;
+		case crypto::Adler32: return WOT_INNOEXTRACT_CHECKSUM_ADLER32;
+		case crypto::CRC32: return WOT_INNOEXTRACT_CHECKSUM_CRC32;
+		case crypto::MD5: return WOT_INNOEXTRACT_CHECKSUM_MD5;
+		case crypto::SHA1: return WOT_INNOEXTRACT_CHECKSUM_SHA1;
+	}
+	return WOT_INNOEXTRACT_CHECKSUM_NONE;
+}
+
+wot_innoextract_compression compression_type(stream::compression_method type) {
+	switch(type) {
+		case stream::Stored: return WOT_INNOEXTRACT_COMPRESSION_STORED;
+		case stream::Zlib: return WOT_INNOEXTRACT_COMPRESSION_ZLIB;
+		case stream::BZip2: return WOT_INNOEXTRACT_COMPRESSION_BZIP2;
+		case stream::LZMA1: return WOT_INNOEXTRACT_COMPRESSION_LZMA1;
+		case stream::LZMA2: return WOT_INNOEXTRACT_COMPRESSION_LZMA2;
+		default: return WOT_INNOEXTRACT_COMPRESSION_UNKNOWN;
+	}
+}
+
+std::string hex_checksum(const crypto::checksum & value) {
+	char byte[3];
+	std::string result;
+	switch(value.type) {
+		case crypto::None: return result;
+		case crypto::Adler32:
+		case crypto::CRC32: {
+			boost::uint32_t number = value.type == crypto::Adler32
+			                       ? value.adler32 : value.crc32;
+			char buffer[9];
+			std::snprintf(buffer, sizeof(buffer), "%08x", unsigned(number));
+			return buffer;
+		}
+		case crypto::MD5:
+			result.reserve(32);
+			for(size_t i = 0; i < sizeof(value.md5); i++) {
+				std::snprintf(byte, sizeof(byte), "%02x",
+				              unsigned(static_cast<unsigned char>(value.md5[i])));
+				result += byte;
+			}
+			return result;
+		case crypto::SHA1:
+			result.reserve(40);
+			for(size_t i = 0; i < sizeof(value.sha1); i++) {
+				std::snprintf(byte, sizeof(byte), "%02x",
+				              unsigned(static_cast<unsigned char>(value.sha1[i])));
+				result += byte;
+			}
+			return result;
+	}
+	return result;
+}
+
+bool strip_app_destination(const std::string & stored, std::string & relative) {
+	static const char AppRoot[] = "{app}\\";
+	static const size_t AppRootLength = sizeof(AppRoot) - 1;
+	if(stored.size() <= AppRootLength
+	   || stored.compare(0, AppRootLength, AppRoot) != 0) {
+		return false;
+	}
+	const std::string::const_iterator begin = stored.begin() + AppRootLength;
+	if(std::find(begin, stored.end(), '{') != stored.end()
+	   || std::find(begin, stored.end(), '}') != stored.end()) {
+		return false;
+	}
+	relative.assign(begin, stored.end());
+	return !relative.empty() && relative.size() <= 4096;
+}
+
+bool targets_app_destination(const std::string & stored) {
+	static const char AppRoot[] = "{app}\\";
+	static const size_t AppRootLength = sizeof(AppRoot) - 1;
+	return stored == "{app}"
+	    || (stored.size() >= AppRootLength
+	        && stored.compare(0, AppRootLength, AppRoot) == 0);
+}
+
+bool strip_recovered_gog_destination(
+    const std::string & stored, std::string & relative) {
+	if(stored.empty() || stored.size() > 4096 || stored[0] == '\\'
+	   || stored[0] == '/' || stored.find(':') != std::string::npos
+	   || stored.find('{') != std::string::npos
+	   || stored.find('}') != std::string::npos) {
+		return false;
+	}
+	relative = stored;
+	return true;
+}
+
+struct adapter_entry {
+	std::string name;
+	std::string checksum;
+	size_t file_index;
+	std::vector<size_t> data_indices;
+	crypto::checksum whole_checksum;
+	wot_innoextract_entry public_entry;
+
+	adapter_entry() : file_index(0) {
+		public_entry.name_utf8 = NULL;
+		public_entry.uncompressed_size = 0;
+		public_entry.checksum_type = WOT_INNOEXTRACT_CHECKSUM_NONE;
+		public_entry.checksum_hex = NULL;
+		public_entry.compression = WOT_INNOEXTRACT_COMPRESSION_UNKNOWN;
+	}
+
+	void bind_pointers() {
+		public_entry.name_utf8 = name.c_str();
+		public_entry.checksum_hex = checksum.c_str();
+	}
+};
