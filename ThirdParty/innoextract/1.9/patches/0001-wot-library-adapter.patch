--- /dev/null
+++ b/src/stream/callback.hpp
@@ -0,0 +1,55 @@
+/* WoT callback-backed, seekable input stream. No path or FILE* exists here. */
+#ifndef INNOEXTRACT_STREAM_CALLBACK_HPP
+#define INNOEXTRACT_STREAM_CALLBACK_HPP
+
+#include <istream>
+#include <streambuf>
+
+#include <boost/cstdint.hpp>
+
+#include "wot/innoextract_adapter.h"
+
+namespace stream {
+
+class callback_streambuf : public std::streambuf {
+public:
+	callback_streambuf(wot_innoextract_read_at_fn read_at, void * context,
+	                   boost::uint64_t size);
+
+	bool callback_failed() const { return callback_failed_; }
+
+protected:
+	int_type underflow();
+	pos_type seekoff(off_type offset, std::ios_base::seekdir direction,
+	                 std::ios_base::openmode mode);
+	pos_type seekpos(pos_type position, std::ios_base::openmode mode);
+
+private:
+	pos_type seek_absolute(boost::uint64_t position);
+	boost::uint64_t logical_position() const;
+
+	wot_innoextract_read_at_fn read_at_;
+	void * context_;
+	boost::uint64_t size_;
+	boost::uint64_t next_offset_;
+	bool callback_failed_;
+	char buffer_[64 * 1024];
+};
+
+class callback_istream : public std::istream {
+public:
+	callback_istream(wot_innoextract_read_at_fn read_at, void * context,
+	                 boost::uint64_t size)
+		: std::istream(NULL), buffer_(read_at, context, size) {
+		rdbuf(&buffer_);
+	}
+
+	bool callback_failed() const { return buffer_.callback_failed(); }
+
+private:
+	callback_streambuf buffer_;
+};
+
+} // namespace stream
+
+#endif // INNOEXTRACT_STREAM_CALLBACK_HPP
diff --git a/src/stream/callback.cpp b/src/stream/callback.cpp
new file mode 100644
--- /dev/null
+++ b/src/stream/callback.cpp
@@ -0,0 +1,98 @@
+#include "stream/callback.hpp"
+
+#include <algorithm>
+#include <cstring>
+#include <limits>
+
+namespace stream {
+
+callback_streambuf::callback_streambuf(wot_innoextract_read_at_fn read_at,
+                                       void * context, boost::uint64_t size)
+	: read_at_(read_at), context_(context), size_(size), next_offset_(0),
+	  callback_failed_(false) {
+	setg(buffer_, buffer_, buffer_);
+}
+
+boost::uint64_t callback_streambuf::logical_position() const {
+	boost::uint64_t unread = boost::uint64_t(egptr() - gptr());
+	return unread <= next_offset_ ? next_offset_ - unread : 0;
+}
+
+callback_streambuf::int_type callback_streambuf::underflow() {
+	if(gptr() < egptr()) {
+		return traits_type::to_int_type(*gptr());
+	}
+	if(next_offset_ >= size_ || callback_failed_ || read_at_ == NULL) {
+		return traits_type::eof();
+	}
+	boost::uint64_t requested = std::min<boost::uint64_t>(sizeof(buffer_),
+	                                                    size_ - next_offset_);
+	boost::int64_t read = read_at_(context_, next_offset_, buffer_, requested);
+	if(read < 0 || boost::uint64_t(read) > requested) {
+		callback_failed_ = true;
+		return traits_type::eof();
+	}
+	if(read == 0) {
+		// The caller declared an explicit size. EOF before that size is I/O failure.
+		callback_failed_ = true;
+		return traits_type::eof();
+	}
+	next_offset_ += boost::uint64_t(read);
+	setg(buffer_, buffer_, buffer_ + read);
+	return traits_type::to_int_type(*gptr());
+}
+
+callback_streambuf::pos_type callback_streambuf::seek_absolute(
+    boost::uint64_t position) {
+	if(position > size_ || position > boost::uint64_t(
+			std::numeric_limits<off_type>::max())) {
+		return pos_type(off_type(-1));
+	}
+	next_offset_ = position;
+	setg(buffer_, buffer_, buffer_);
+	return pos_type(off_type(position));
+}
+
+callback_streambuf::pos_type callback_streambuf::seekpos(
+    pos_type position, std::ios_base::openmode mode) {
+	if(!(mode & std::ios_base::in)) {
+		return pos_type(off_type(-1));
+	}
+	off_type signed_position = off_type(position);
+	if(signed_position < 0) {
+		return pos_type(off_type(-1));
+	}
+	return seek_absolute(boost::uint64_t(signed_position));
+}
+
+callback_streambuf::pos_type callback_streambuf::seekoff(
+    off_type offset, std::ios_base::seekdir direction,
+    std::ios_base::openmode mode) {
+	if(!(mode & std::ios_base::in)) {
+		return pos_type(off_type(-1));
+	}
+	boost::uint64_t base;
+	if(direction == std::ios_base::beg) {
+		base = 0;
+	} else if(direction == std::ios_base::cur) {
+		base = logical_position();
+	} else if(direction == std::ios_base::end) {
+		base = size_;
+	} else {
+		return pos_type(off_type(-1));
+	}
+	if(offset < 0) {
+		boost::uint64_t magnitude = boost::uint64_t(-(offset + 1)) + 1;
+		if(magnitude > base) {
+			return pos_type(off_type(-1));
+		}
+		return seek_absolute(base - magnitude);
+	}
+	boost::uint64_t positive = boost::uint64_t(offset);
+	if(positive > size_ - std::min(base, size_)) {
+		return pos_type(off_type(-1));
+	}
+	return seek_absolute(base + positive);
+}
+
+} // namespace stream
