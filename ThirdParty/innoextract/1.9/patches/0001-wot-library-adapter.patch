+struct wot_innoextract_extraction_cursor {
+	std::unique_ptr<stream::callback_istream> input;
+	std::unique_ptr<stream::slice_reader> slices;
+	stream::chunk_reader::pointer chunk;
+	stream::chunk chunk_info;
+	boost::uint64_t position;
+	bool active;
