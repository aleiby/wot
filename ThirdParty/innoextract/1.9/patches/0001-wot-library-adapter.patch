+struct wot_innoextract_package {
+	wot_innoextract_read_at_fn read_at;
+	void * read_context;
+	boost::uint64_t input_size;
+	loader::offsets offsets;
+	setup::info info;
+	std::vector<adapter_entry> entries;
+	std::string description;
+	mutable wot_innoextract_extraction_cursor cursor;
+
+	wot_innoextract_package(wot_innoextract_read_at_fn callback, void * context,
+	                       boost::uint64_t size)
+		: read_at(callback), read_context(context), input_size(size) { }
+};
+
+namespace {
+
+void prepare_cursor(const wot_innoextract_package * package,
+                    const setup::data_entry & data) {
+	wot_innoextract_extraction_cursor & cursor = package->cursor;
+	if(!cursor.active || !(cursor.chunk_info == data.chunk)
+	   || cursor.position > data.file.offset) {
+		cursor.reset();
+		cursor.input.reset(new stream::callback_istream(
+			package->read_at, package->read_context, package->input_size));
+		cursor.slices.reset(new stream::slice_reader(
+			cursor.input.get(), package->offsets.data_offset));
+		cursor.chunk = stream::chunk_reader::get(
+			*cursor.slices, data.chunk, std::string());
+		cursor.chunk_info = data.chunk;
+		cursor.position = 0;
+		cursor.active = true;
+	}
+	if(cursor.position < data.file.offset) {
+		util::discard(*cursor.chunk, data.file.offset - cursor.position);
+		cursor.position = data.file.offset;
+	}
+}
+
+int32_t open_impl(wot_innoextract_read_at_fn read_at, void * read_context,
+                  boost::uint64_t input_size,
+                  wot_innoextract_package ** output_package) {
+	if(read_at == NULL || output_package == NULL || input_size == 0
+	   || input_size > boost::uint64_t(std::numeric_limits<std::streamoff>::max())) {
+		set_error("invalid read callback, output pointer, or input size");
+		return WOT_INNOEXTRACT_INVALID_ARGUMENT;
+	}
+	*output_package = NULL;
+	std::unique_ptr<wot_innoextract_package> package(
+		new wot_innoextract_package(read_at, read_context, input_size));
